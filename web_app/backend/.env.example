# Database (Docker containers)
DATABASE_URL=postgresql://codecome:codecome@localhost:15432/codecome_db

# Redis (Docker container)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Workspaces
WORKSPACES_DIR=/home/derekkddj/syncresilio/tools/08_TETools/workspaces
CODECOME_ROOT=/home/derekkddj/syncresilio/tools/08_TETools/CodeCome_WEB

# Optional audit workspace VS Code access.
# Safe local default binds code-server to localhost on the web host.
# For LAN/server access, set CODE_SERVER_BIND_ADDR=0.0.0.0 and CODE_SERVER_PUBLIC_BASE_URL=http://server-ip-or-name
CODE_SERVER_BIND_ADDR=127.0.0.1
CODE_SERVER_PUBLIC_BASE_URL=

# Application
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Security
SECRET_KEY=your-secret-key-here-change-in-production
